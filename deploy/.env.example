# 复制为 deploy/.env（docker compose 读取）
# ---------- 数据库（dev 与 full 栈共用） ----------
OPS_DB_PASSWORD=请改成随机密码
# 代理不通拉不了 timescale 镜像时的兜底（数据卷不通用，切换需 docker compose down -v 重建）：
# OPS_DB_IMAGE=postgres:16-alpine
# 后端数据库连接池（并发采集/告警评估会短时占满连接，默认 20+40）
# OPS_DB_POOL_SIZE=20
# OPS_DB_MAX_OVERFLOW=40

# ---------- 以下为 full 栈（docker-compose.full.yml）使用 ----------
# 凭据加密 Fernet 密钥，生产必须显式配置；换密钥=已保存的设备凭据全部失效！
# 生成方法：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
OPS_FERNET_KEY=
# JWT 签名密钥（≥32 字节随机串），生产必须显式设置（compose 已强制必填）
# 生成方法：python -c "import secrets;print(secrets.token_hex(32))"
OPS_SECRET_KEY=
# 默认管理员（仅首次启动创建，首登后请立即改密）；生产必须显式设置口令（compose 已强制必填）
OPS_ADMIN_USERNAME=admin
OPS_ADMIN_PASSWORD=
# web 服务对外端口（本机 8000 已被占用，默认 8080）
OPS_WEB_PORT=8080
# Syslog / SNMP Trap 接收端口（UDP，宿主侧；容器内固定 1514/1162，冲突时改这里）
# OPS_SYSLOG_PORT=1514
# OPS_TRAP_PORT=1162
# Syslog / SNMP Trap 来源 IP 白名单（逗号分隔 IP/CIDR；留空=全部接收）
# OPS_SYSLOG_ALLOW=
# OPS_TRAP_ALLOW=
