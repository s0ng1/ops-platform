# 前端镜像（内网运维管理平台）：Node 构建 + Nginx 托管
# 构建上下文为项目根目录：docker compose -f deploy/docker-compose.full.yml build web
FROM node:20-alpine AS build

WORKDIR /build

# 先复制锁文件装依赖，利用构建缓存（有 package-lock.json，用 npm ci）
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

# 运行阶段：nginx 托管 SPA 并反代 /api（含 WebSocket）
FROM nginx:alpine
COPY --from=build /build/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
