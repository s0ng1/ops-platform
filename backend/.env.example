# 复制为 backend/.env 按需修改（全部可选，开发可不用）
OPS_DATABASE_URL=sqlite:///./data/ops_platform.db
# 生产示例：OPS_DATABASE_URL=postgresql+psycopg://ops:密码@127.0.0.1:5432/ops
OPS_SECRET_KEY=请改成至少32字节的随机串
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OPS_FERNET_KEY=
OPS_MONITOR_INTERVAL=60
OPS_ADMIN_USERNAME=admin
OPS_ADMIN_PASSWORD=admin123
